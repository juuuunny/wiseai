# Database Configuration
# 로컬 개발 환경: docker-compose의 db 서비스 사용
# 프로덕션 환경: 실제 데이터베이스 URL로 변경
DB_URL=jdbc:mysql://db:3306/assignment?useSSL=false&allowPublicKeyRetrieval=true&characterEncoding=utf8&serverTimezone=UTC
DB_USERNAME=assignment
DB_PASSWORD=assignment

# Server Configuration
SERVER_PORT=8080

# Spring Profile (docker, default, prod)
SPRING_PROFILES_ACTIVE=docker

# 추가 환경 변수는 아래에 작성하세요
# 예시:
# REDIS_HOST=localhost
# REDIS_PORT=6379
# JWT_SECRET=your-secret-key
